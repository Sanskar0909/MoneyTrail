# Settings for docker-compose.prod.yml. On the server: copy to .env and fill in.
# .env is gitignored. Never commit the real one.

# The address people type, without https://. The web server gets the certificate for it.
SITE_ADDRESS=moneytrail.example.com

# Make these up. Long and random; nobody has to type them.
DB_PASSWORD=
MINIO_ROOT_USER=moneytrail
MINIO_ROOT_PASSWORD=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview

# The one login for the whole site. The password is stored hashed; make the hash with
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
# and keep the single quotes around it here, or the $ signs in it get mangled.
BASIC_AUTH_USER=
BASIC_AUTH_HASH=''
